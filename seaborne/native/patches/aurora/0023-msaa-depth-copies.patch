 bool snapshot_depth_supported() noexcept { return static_cast<bool>(g_depthSnapshotPipeline); }
+
+wgpu::TextureView resolve_depth(const wgpu::CommandEncoder& cmd, const wgpu::TextureView& srcDepthMS,
+                                const wgpu::Extent3D& size) {
+  if (!g_depthResolvePipelineMS || size.width == 0 || size.height == 0) {
+    return {};
+  }
+  if (!g_resolvedDepth || g_resolvedDepthSize.width != size.width || g_resolvedDepthSize.height != size.height) {
+    const wgpu::TextureDescriptor desc{
+        .label = "Resolved depth",
+        .usage = wgpu::TextureUsage::RenderAttachment | wgpu::TextureUsage::TextureBinding,
+        .dimension = wgpu::TextureDimension::e2D,
+        .size = {size.width, size.height, 1},
+        .format = webgpu::g_graphicsConfig.depthFormat,
+        .mipLevelCount = 1,
+        .sampleCount = 1,
+    };
+    g_resolvedDepth = g_device.CreateTexture(&desc);
+    g_resolvedDepthView = g_resolvedDepth.CreateView();
+    g_resolvedDepthSize = {size.width, size.height, 1};
+  }
+  const std::array bindGroupEntries{
+      wgpu::BindGroupEntry{
+          .binding = 0,
+          .textureView = srcDepthMS,
+      },
+  };
+  const wgpu::BindGroupDescriptor bindGroupDescriptor{
+      .layout = g_depthSnapshotBindGroupLayoutMS,
+      .entryCount = bindGroupEntries.size(),
+      .entries = bindGroupEntries.data(),
+  };
+  const auto bindGroup = g_device.CreateBindGroup(&bindGroupDescriptor);
+  const wgpu::RenderPassDepthStencilAttachment depthAttachment{
+      .view = g_resolvedDepthView,
+      .depthLoadOp = wgpu::LoadOp::Clear,
+      .depthStoreOp = wgpu::StoreOp::Store,
+      .depthClearValue = 1.0f,
+  };
+  const wgpu::RenderPassDescriptor renderPassDescriptor{
+      .label = "Depth Resolve Pass",
+      .colorAttachmentCount = 0,
+      .depthStencilAttachment = &depthAttachment,
+      .timestampWrites = webgpu::gpu_prof::pass_writes("Depth resolve"),
+  };
+  const auto pass = cmd.BeginRenderPass(&renderPassDescriptor);
+  pass.SetPipeline(g_depthResolvePipelineMS);
+  pass.SetBindGroup(0, bindGroup);
+  pass.Draw(3);
+  pass.End();
+  return g_resolvedDepthView;
+}
 
