<Project>
    <!--
      Generates Data/PuppetLayout.g.cs from GameMod/src/puppet_link/puppet_shared.h so the
      C# client and the injected C code share ONE definition of every emulator address/offset.

      Every `#define NAME <integer literal>` in the header becomes `PuppetLayout.NAME`.
      Expressions and function-like macros are skipped (derive them in C# instead).
      Values that fit in int are emitted as int, larger ones (addresses) as uint.

      The output lives in the source tree (not obj/) so IDEs always see it; it is only
      rewritten when its content would change, so it never churns dotnet watch.
    -->
    <PropertyGroup>
        <PuppetSharedHeader>$(MSBuildThisFileDirectory)..\..\GameMod\src\puppet_link\puppet_shared.h</PuppetSharedHeader>
        <PuppetLayoutOutput>$(MSBuildThisFileDirectory)..\Data\PuppetLayout.g.cs</PuppetLayoutOutput>
    </PropertyGroup>

    <UsingTask TaskName="GeneratePuppetLayout"
               TaskFactory="RoslynCodeTaskFactory"
               AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <HeaderPath ParameterType="System.String" Required="true" />
            <OutputPath ParameterType="System.String" Required="true" />
        </ParameterGroup>
        <Task>
            <Using Namespace="System" />
            <Using Namespace="System.IO" />
            <Using Namespace="System.Text" />
            <Using Namespace="System.Text.RegularExpressions" />
            <Code Type="Fragment" Language="cs"><![CDATA[
                var define = new Regex(
                    @"^\s*#define\s+([A-Za-z_][A-Za-z0-9_]*)\s+(0[xX][0-9A-Fa-f]+|[0-9]+)[uU]?\s*(?:/\*\s*(.*?)\s*\*/)?\s*$");

                var sb = new StringBuilder();
                sb.AppendLine("// <auto-generated>");
                sb.AppendLine("// Generated from GameMod/src/puppet_link/puppet_shared.h by");
                sb.AppendLine("// WWOnline.Client/build/PuppetLayout.targets. DO NOT EDIT —");
                sb.AppendLine("// change the header and rebuild. The header is the single source of truth.");
                sb.AppendLine("// </auto-generated>");
                sb.AppendLine("namespace WWOnline.Data;");
                sb.AppendLine();
                sb.AppendLine("public static class PuppetLayout");
                sb.AppendLine("{");

                int count = 0;
                foreach (var line in File.ReadAllLines(HeaderPath))
                {
                    var m = define.Match(line);
                    if (!m.Success) continue;

                    string name = m.Groups[1].Value;
                    string literal = m.Groups[2].Value;
                    string comment = m.Groups[3].Value;

                    ulong value = literal.StartsWith("0x", StringComparison.OrdinalIgnoreCase)
                        ? Convert.ToUInt64(literal.Substring(2), 16)
                        : ulong.Parse(literal);
                    string type = value <= int.MaxValue ? "int" : "uint";

                    if (comment.Length > 0)
                    {
                        string escaped = comment.Replace("&", "&amp;").Replace("<", "&lt;").Replace(">", "&gt;");
                        sb.AppendLine("    /// <summary>" + escaped + "</summary>");
                    }
                    sb.AppendLine("    public const " + type + " " + name + " = " + literal + ";");
                    count++;
                }
                sb.AppendLine("}");

                string text = sb.ToString();
                string existing = File.Exists(OutputPath) ? File.ReadAllText(OutputPath) : null;
                if (existing != text)
                {
                    File.WriteAllText(OutputPath, text);
                    Log.LogMessage(MessageImportance.High, "PuppetLayout: regenerated " + count + " constants from puppet_shared.h");
                }
            ]]></Code>
        </Task>
    </UsingTask>

    <Target Name="GeneratePuppetLayout" BeforeTargets="BeforeBuild;CoreCompile">
        <Error Condition="!Exists('$(PuppetSharedHeader)')"
               Text="puppet_shared.h not found at $(PuppetSharedHeader) — PuppetLayout.g.cs cannot be generated." />
        <GeneratePuppetLayout HeaderPath="$(PuppetSharedHeader)" OutputPath="$(PuppetLayoutOutput)" />
        <!-- Normally the default **/*.cs glob already includes it; this covers the build where the
             file didn't exist yet at evaluation time (fresh clone / deleted). -->
        <ItemGroup>
            <Compile Include="Data\PuppetLayout.g.cs" Exclude="@(Compile)" />
        </ItemGroup>
    </Target>
</Project>
