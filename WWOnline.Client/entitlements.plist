<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Allow debugging other processes -->
    <key>com.apple.security.cs.debugger</key>
    <true/>
    
    <!-- Disable library validation to allow injecting into other processes -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    
    <!-- Allow task_for_pid() -->
    <key>com.apple.security.cs.allow-task-for-pid</key>
    <true/>
    
    <!-- Disable sandbox for unrestricted access -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
    
    <!-- Allow unsigned executable memory (sometimes needed for memory manipulation) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
</dict>
</plist>