<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WWOnline.ViewModels"
             x:Class="WWOnline.Views.RoomFlagsView"
             x:DataType="vm:RoomFlagsViewModel"
             x:Name="Root">

    <UserControl.Styles>
        <!-- Flag row: the whole row is the hit target; hover only when it can be toggled -->
        <Style Selector="Button.flag-row">
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="MinHeight" Value="54" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="Button.flag-row /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style Selector="Button.flag-row:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style Selector="Button.flag-row:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.flag-row:pressed">
            <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="Button.flag-row.editable">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.flag-row.editable:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
        </Style>

        <!-- Tick box -->
        <Style Selector="Border.tick">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}" />
            <Setter Property="Background" Value="{StaticResource InsetBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.tick.on">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="Button.flag-row.editable:pointerover Border.tick">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>

        <!-- Tag chips: class, scope (Shared / This game only), Risky -->
        <Style Selector="Border.tag">
            <Setter Property="CornerRadius" Value="{StaticResource PillRadius}" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.tag TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.tag.story">
            <Setter Property="Background" Value="{StaticResource StoryTintBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StoryTintBrush}" />
        </Style>
        <Style Selector="Border.tag.story TextBlock">
            <Setter Property="Foreground" Value="{StaticResource StoryLightBrush}" />
        </Style>
        <Style Selector="Border.tag.shared">
            <Setter Property="Background" Value="{StaticResource RupeeTintBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource RupeeTintBrush}" />
        </Style>
        <Style Selector="Border.tag.shared TextBlock">
            <Setter Property="Foreground" Value="{StaticResource RupeeBrush}" />
        </Style>
        <Style Selector="Border.tag.local">
            <Setter Property="Background" Value="{StaticResource RaisedAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}" />
        </Style>
        <Style Selector="Border.tag.local TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextNavBrush}" />
        </Style>
        <Style Selector="Border.tag.risky">
            <Setter Property="Background" Value="{StaticResource DangerTintBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DangerLineBrush}" />
        </Style>
        <Style Selector="Border.tag.risky TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        </Style>

        <!-- Primary name: the decomp name; placeholder UNK_ names dimmer -->
        <Style Selector="TextBlock.flag-name">
            <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid Margin="32,28,32,32" RowDefinitions="Auto,Auto,Auto,Auto,*">

        <!-- Header -->
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="6">
                <Button Classes="ww-textlink" Command="{Binding BackCommand}" HorizontalAlignment="Left" AutomationProperties.Name="Back to Room">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                            <Path Classes="icon" StrokeThickness="2" Data="{StaticResource IconArrowLeft}"
                                  Stroke="{Binding $parent[Button].Foreground}" />
                        </Viewbox>
                        <TextBlock Text="Room" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding PageTitle}" Classes="ww-title" />
                <TextBlock Text="{Binding PageSubtitle}" FontSize="14" Foreground="{StaticResource Text2Brush}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="16,0,0,0">
                <Border Classes="ww-chip" Background="{StaticResource RupeeTintBrush}" IsVisible="{Binding IsRoomMode}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource RupeeBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SyncedText}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource RupeeBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Classes="ww-chip" IsVisible="{Binding !IsRoomMode}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Viewbox Width="15" Height="15" VerticalAlignment="Center">
                            <Path Classes="icon" StrokeThickness="1.9" Data="{StaticResource IconMonitor}" Stroke="{StaticResource TextNavBrush}" />
                        </Viewbox>
                        <TextBlock Text="{Binding SyncedText}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextNavBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Classes="ww-chip" IsVisible="{Binding ShowViewOnly}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Viewbox Width="15" Height="15" VerticalAlignment="Center">
                            <Path Classes="icon" StrokeThickness="1.9" Data="{StaticResource IconLock}" Stroke="{StaticResource TextNavBrush}" />
                        </Viewbox>
                        <TextBlock Text="View only" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextNavBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Button Classes="ww-primary" Command="{Binding StartEditCommand}" IsVisible="{Binding ShowEditButton}" AutomationProperties.Name="Edit flags">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                            <Path Classes="icon" StrokeThickness="2" Data="{StaticResource IconPencil}" Stroke="{StaticResource GroundBrush}" />
                        </Viewbox>
                        <TextBlock Text="Edit flags" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="ww-accent" Command="{Binding StopEditCommand}" IsVisible="{Binding IsEditing}" AutomationProperties.Name="Done">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                            <Path Classes="icon" StrokeThickness="2.4" Data="{StaticResource IconCheck}" Stroke="{StaticResource OnAccentBrush}" />
                        </Viewbox>
                        <TextBlock Text="Done" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Editing banner -->
        <Border Grid.Row="1" Classes="ww-edit-banner" IsVisible="{Binding IsEditing}" Margin="0,14,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                    <Path Classes="icon" StrokeThickness="2" Data="{StaticResource IconPencil}" Stroke="{StaticResource GoldCBrush}" />
                </Viewbox>
                <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center" TextWrapping="Wrap"
                           FontSize="14" Foreground="{StaticResource GoldTextBrush}">
                    <Run Text="{Binding EditBannerTitle}" FontWeight="Bold" Foreground="{StaticResource GoldTextStrongBrush}" /><Run Text=" " /><Run Text="{Binding EditBannerText}" />
                </TextBlock>
                <TextBlock Grid.Column="2" Text="Press Done to lock it again" FontSize="13"
                           Foreground="{StaticResource GoldTextSoftBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Status of the last edit -->
        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Classes="ww-mono" FontSize="13" Foreground="{StaticResource AccentHoverBrush}"
                   TextWrapping="Wrap" Margin="0,14,0,0"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <!-- Nothing known yet -->
        <Border Grid.Row="3" Classes="ww-info-banner" IsVisible="{Binding !HasData}" Margin="0,14,0,0">
            <Grid ColumnDefinitions="Auto,*">
                <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                    <Path Classes="icon" Data="{StaticResource IconInfo}" Stroke="{StaticResource AccentBrush}" />
                </Viewbox>
                <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{Binding WaitingText}" TextWrapping="Wrap" Foreground="#BDEFE8" />
            </Grid>
        </Border>

        <Grid Grid.Row="4" ColumnDefinitions="*,20,360" Margin="0,22,0,0">

            <!-- ═══ Left: the flag list ═══ -->
            <Border Classes="ww-card" Classes.editing="{Binding IsEditing}" Padding="24,22,14,14">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,10,0">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Flags" Classes="ww-card-title" />
                            <TextBlock Text="{Binding SetCountText}" FontSize="13" Foreground="{StaticResource Text2Brush}" />
                        </StackPanel>
                        <Border Grid.Column="2" Width="300" Height="44" CornerRadius="12" Padding="14,0"
                                Background="{StaticResource InputBrush}" BorderBrush="{StaticResource InputLineBrush}" BorderThickness="1">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                    <Path Classes="icon" StrokeThickness="1.9" Data="{StaticResource IconSearch}" Stroke="{StaticResource Text3Brush}" />
                                </Viewbox>
                                <TextBox Grid.Column="1" Classes="bare" Margin="8,0,0,0" Text="{Binding Search}"
                                         Watermark="Name, description or code" VerticalAlignment="Center"
                                         AutomationProperties.Name="Search flags" />
                                <Button Grid.Column="2" Classes="ww-textlink" Content="Clear" Command="{Binding ClearSearchCommand}"
                                        IsVisible="{Binding Search, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,14,10,8">
                        <ToggleButton Classes="ww-switch" IsChecked="{Binding ShowUnknown}" AutomationProperties.Name="Show unknown flags"
                                      ToolTip.Tip="Flags the decomp only knows as UNK_xxxx, with no description yet" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ShowUnknownText}" FontSize="13" Foreground="{StaticResource Text2Brush}"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{Binding VisibleCountText}" FontSize="12" Foreground="{StaticResource Text3Brush}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Panel Grid.Row="2">
                        <TextBlock Text="No flags match. A search looks through every flag, unknown ones too."
                                   FontSize="13" Foreground="{StaticResource Text2Brush}" TextWrapping="Wrap" Margin="0,8,10,0"
                                   IsVisible="{Binding HasNoMatches}" />
                        <!-- Virtualised: only the rows on screen are built -->
                        <ItemsControl ItemsSource="{Binding VisibleRows}">
                            <ItemsControl.Template>
                                <ControlTemplate>
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" Margin="0,0,10,0" />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:StoryFlagRow">
                                    <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource CardLineBrush}" Padding="0,2">
                                        <Button Classes="flag-row" Classes.editable="{Binding CanToggle}"
                                                Command="{Binding #Root.((vm:RoomFlagsViewModel)DataContext).ToggleFlagCommand}"
                                                CommandParameter="{Binding}" ToolTip.Tip="{Binding Tooltip}"
                                                AutomationProperties.Name="{Binding Name}">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                                                <Border Classes="tick" Classes.on="{Binding IsSet}">
                                                    <Viewbox Width="12" Height="12" IsVisible="{Binding IsSet}">
                                                        <Path Classes="icon" StrokeThickness="3.2" Data="{StaticResource IconCheck}" Stroke="{StaticResource OnAccentBrush}" />
                                                    </Viewbox>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="14,6,12,6" Spacing="2" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding Name}" Classes="flag-name" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        <Viewbox Width="13" Height="13" VerticalAlignment="Center" IsVisible="{Binding ShowLock}">
                                                            <Path Classes="icon" StrokeThickness="2" Data="{StaticResource IconLock}" Stroke="{StaticResource Text3Brush}" />
                                                        </Viewbox>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" FontSize="13" Foreground="{StaticResource Text2Brush}"
                                                               TextTrimming="CharacterEllipsis" IsVisible="{Binding HasDescription}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Code}" FontFamily="{StaticResource FontMono}" FontSize="12"
                                                           Foreground="{StaticResource Text3Brush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                <Border Grid.Column="3" Classes="tag" Classes.story="{Binding IsStoryClass}">
                                                    <TextBlock Text="{Binding ClassText}" />
                                                </Border>
                                                <Border Grid.Column="4" Classes="tag shared" IsVisible="{Binding IsShared}"
                                                        ToolTip.Tip="With Shared story on, this flag merges into the room and reaches every player.">
                                                    <TextBlock Text="Shared" />
                                                </Border>
                                                <Border Grid.Column="4" Classes="tag local" IsVisible="{Binding IsLocalOnly}"
                                                        ToolTip.Tip="Never synced: this flag stays in this game and never reaches other players.">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Viewbox Width="11" Height="11" VerticalAlignment="Center">
                                                            <Path Classes="icon" StrokeThickness="2.2" Data="{StaticResource IconMonitor}" Stroke="{StaticResource TextNavBrush}" />
                                                        </Viewbox>
                                                        <TextBlock Text="This game only" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="5" Classes="tag risky" IsVisible="{Binding IsRisky}" ToolTip.Tip="{Binding RiskText}">
                                                    <TextBlock Text="Risky" />
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Panel>
                </Grid>
            </Border>

            <!-- ═══ Right: what the tags mean, registers ═══ -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="20">
                    <Border Classes="ww-card" Padding="22,20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="What the tags mean" Classes="ww-card-title" FontSize="18" />
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Classes="tag shared" Margin="0" VerticalAlignment="Top"><TextBlock Text="Shared" /></Border>
                                <TextBlock Grid.Column="1" Margin="10,0,0,0" FontSize="13" Foreground="{StaticResource Text2Brush}" TextWrapping="Wrap"
                                           Text="With Shared story on, it merges into the room and every player gets it." />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Classes="tag local" Margin="0" VerticalAlignment="Top"><TextBlock Text="This game only" /></Border>
                                <TextBlock Grid.Column="1" Margin="10,0,0,0" FontSize="13" Foreground="{StaticResource Text2Brush}" TextWrapping="Wrap"
                                           Text="Never synced. The game resets it or it describes your own ship, clock or spawn." />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Classes="tag risky" Margin="0" VerticalAlignment="Top"><TextBlock Text="Risky" /></Border>
                                <TextBlock Grid.Column="1" Margin="10,0,0,0" FontSize="13" Foreground="{StaticResource Text2Brush}" TextWrapping="Wrap"
                                           Text="Setting it without its normal trigger has a known side effect. Hover a flag to see it." />
                            </Grid>
                            <TextBlock FontSize="13" Foreground="{StaticResource Text2Brush}" TextWrapping="Wrap"
                                       Text="The other tag is the flag's class from the decomp: Story, Cutscene seen, Side quest, Collectible, NPC state, Tutorial hint, Local only or Unknown." />
                            <Border CornerRadius="12" Background="{StaticResource InsetBrush}" Padding="12,10" IsVisible="{Binding IsRoomMode}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Viewbox Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,0,0">
                                        <Path Classes="icon" Data="{StaticResource IconLock}" Stroke="{StaticResource Text2Brush}" />
                                    </Viewbox>
                                    <TextBlock Grid.Column="1" Margin="10,0,0,0" FontSize="13" Foreground="{StaticResource Text2Brush}" TextWrapping="Wrap"
                                               Text="The room keeps story progress; flags can't be removed from a shared room yet." />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Expander HorizontalAlignment="Stretch" AutomationProperties.Name="Advanced: event registers">
                        <Expander.Header>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Advanced: event registers" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="This game only. Never synced, except the figurines." FontSize="12" Foreground="{StaticResource Text2Brush}" />
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Spacing="10" Margin="10,6,4,8">
                            <TextBlock FontSize="12" Foreground="{StaticResource Text2Brush}" TextWrapping="Wrap"
                                       Text="Multi-bit values in bytes 0x79-0xFF: letters, counters, figurines, warp pots. Edit mode sets them in your own game. With Shared story on, the Nintendo Gallery figurine bitfields merge into the room." />
                            <ItemsControl ItemsSource="{Binding Registers}" MaxHeight="440">
                                <ItemsControl.Template>
                                    <ControlTemplate>
                                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" Margin="0,0,10,0" />
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:EventRegisterRow">
                                        <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource CardLineBrush}" Padding="0,8" ToolTip.Tip="{Binding Tooltip}">
                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontFamily="{StaticResource FontMono}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock FontSize="11" Foreground="{StaticResource Text3Brush}">
                                                        <Run Text="{Binding Code}" FontFamily="{StaticResource FontMono}" /><Run Text=" · " /><Run Text="{Binding PolicyText}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding ValueText}" FontFamily="{StaticResource FontMono}" FontSize="13"
                                                           VerticalAlignment="Center" Margin="8,0" />
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                                            IsVisible="{Binding #Root.((vm:RoomFlagsViewModel)DataContext).IsEditing}">
                                                    <TextBox Text="{Binding EditText}" Classes="mono" Width="64" MinHeight="34" Padding="8,4" FontSize="12"
                                                             Watermark="0" AutomationProperties.Name="{Binding Name}" />
                                                    <Button Content="Set" Classes="ww-secondary" MinHeight="34" Padding="12,0"
                                                            Command="{Binding #Root.((vm:RoomFlagsViewModel)DataContext).SetRegisterCommand}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
