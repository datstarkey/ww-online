<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WWOnline.ViewModels"
             x:Class="WWOnline.Views.RoomItemsView"
             x:DataType="vm:RoomItemsViewModel"
             x:Name="Root">

    <UserControl.Styles>
        <!-- Item tile: owned = accent border + filled code square; not owned = dashed + dim -->
        <Style Selector="Border.code-square">
            <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
        </Style>
        <Style Selector="Border.code-square.owned">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="Border.code-square TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
        </Style>
        <Style Selector="Border.code-square.owned TextBlock">
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
        </Style>
        <Style Selector="TextBlock.tile-name">
            <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
        </Style>
        <Style Selector="TextBlock.tile-name.owned">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style Selector="Button.ww-bare:pointerover Border.tile-owned">
            <Setter Property="Background" Value="#1A2C36" />
        </Style>
        <Style Selector="Button.ww-bare:pointerover Rectangle.tile-empty">
            <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
        </Style>
        <!-- Triforce shard -->
        <Style Selector="Path.shard">
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke" Value="#3A4C58" />
        </Style>
        <Style Selector="Path.shard.on">
            <Setter Property="Fill" Value="{StaticResource GoldCBrush}" />
            <Setter Property="Stroke" Value="{StaticResource GoldCBrush}" />
        </Style>
        <Style Selector="Button.ww-bare:pointerover Path.shard">
            <Setter Property="Stroke" Value="{StaticResource GoldCBrush}" />
        </Style>
        <!-- Segmented options inside an inset (magic, capacity) -->
        <Style Selector="Button.ww-seg.small">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="9" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,32" Spacing="22">

            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="6">
                    <Button Classes="ww-textlink" Command="{Binding BackCommand}" HorizontalAlignment="Left" AutomationProperties.Name="Back to Room">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                                <Path Classes="icon" StrokeThickness="2" Data="{StaticResource IconArrowLeft}"
                                      Stroke="{Binding $parent[Button].Foreground}" />
                            </Viewbox>
                            <TextBlock Text="Room" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding PageTitle}" Classes="ww-title" />
                    <TextBlock Text="{Binding PageSubtitle}" FontSize="14" Foreground="{StaticResource Text2Brush}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Classes="ww-chip" Background="{StaticResource RupeeTintBrush}" IsVisible="{Binding IsRoomMode}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource RupeeBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SyncedText}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource RupeeBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Classes="ww-chip" IsVisible="{Binding !IsRoomMode}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Viewbox Width="15" Height="15" VerticalAlignment="Center">
                                <Path Classes="icon" StrokeThickness="1.9" Data="{StaticResource IconMonitor}" Stroke="{StaticResource TextNavBrush}" />
                            </Viewbox>
                            <TextBlock Text="{Binding SyncedText}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextNavBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Classes="ww-chip" IsVisible="{Binding ShowViewOnly}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Viewbox Width="15" Height="15" VerticalAlignment="Center">
                                <Path Classes="icon" StrokeThickness="1.9" Data="{StaticResource IconLock}" Stroke="{StaticResource TextNavBrush}" />
                            </Viewbox>
                            <TextBlock Text="View only" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextNavBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Button Classes="ww-primary" Command="{Binding StartEditCommand}" IsVisible="{Binding ShowEditButton}" AutomationProperties.Name="Edit items">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                <Path Classes="icon" StrokeThickness="2" Data="{StaticResource IconPencil}" Stroke="{StaticResource GroundBrush}" />
                            </Viewbox>
                            <TextBlock Text="Edit items" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="ww-accent" Command="{Binding StopEditCommand}" IsVisible="{Binding IsEditing}" AutomationProperties.Name="Done">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                <Path Classes="icon" StrokeThickness="2.4" Data="{StaticResource IconCheck}" Stroke="{StaticResource OnAccentBrush}" />
                            </Viewbox>
                            <TextBlock Text="Done" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Editing banner -->
            <Border Classes="ww-edit-banner" IsVisible="{Binding IsEditing}" Margin="0,-8,0,0">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                        <Path Classes="icon" StrokeThickness="2" Data="{StaticResource IconPencil}" Stroke="{StaticResource GoldCBrush}" />
                    </Viewbox>
                    <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center" TextWrapping="Wrap"
                               FontSize="14" Foreground="{StaticResource GoldTextBrush}">
                        <Run Text="{Binding EditBannerTitle}" FontWeight="Bold" Foreground="{StaticResource GoldTextStrongBrush}" /><Run Text=" " /><Run Text="{Binding EditBannerText}" />
                    </TextBlock>
                    <TextBlock Grid.Column="2" Text="Press Done to lock it again" FontSize="13"
                               Foreground="{StaticResource GoldTextSoftBrush}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Status of the last edit -->
            <TextBlock Text="{Binding StatusMessage}" Classes="ww-mono" FontSize="13" Foreground="{StaticResource AccentHoverBrush}"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <!-- Nothing known yet -->
            <Border Classes="ww-info-banner" IsVisible="{Binding !HasSnapshot}">
                <Grid ColumnDefinitions="Auto,*">
                    <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                        <Path Classes="icon" Data="{StaticResource IconInfo}" Stroke="{StaticResource AccentBrush}" />
                    </Viewbox>
                    <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{Binding WaitingText}" TextWrapping="Wrap" Foreground="#BDEFE8" />
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,20,400">
                <!-- ═══ Left: item menu + quest status ═══ -->
                <StackPanel Grid.Column="0" Spacing="20">
                    <Border Classes="ww-card" Padding="24,22">
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBlock Text="Item menu" Classes="ww-card-title" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding OwnedCountText}" FontSize="13" Foreground="{StaticResource Text2Brush}"
                                           VerticalAlignment="Center" Margin="0,0,16,0" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Border Width="10" Height="10" CornerRadius="3" Background="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding LegendText}" FontSize="12" Foreground="{StaticResource Text2Brush}" />
                                </StackPanel>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Tiles}" IsEnabled="{Binding IsEditing}" Margin="-5">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="6" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ItemTileViewModel">
                                        <Button Classes="ww-bare" Margin="5" Height="92" HorizontalAlignment="Stretch"
                                                Command="{Binding #Root.((vm:RoomItemsViewModel)DataContext).ToggleItemCommand}"
                                                CommandParameter="{Binding Slot}" ToolTip.Tip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
                                            <Panel>
                                                <Rectangle Classes="tile-empty" RadiusX="14" RadiusY="14" Fill="{StaticResource InsetBrush}"
                                                           Stroke="{StaticResource OutlineBrush}" StrokeThickness="1" StrokeDashArray="4,3"
                                                           IsVisible="{Binding !IsOwned}" />
                                                <Border Classes="tile-owned" CornerRadius="14" BorderThickness="1"
                                                        BorderBrush="{StaticResource AccentBrush}" Background="{StaticResource RaisedAltBrush}"
                                                        IsVisible="{Binding IsOwned}" />
                                                <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6">
                                                    <Border Classes="code-square" Classes.owned="{Binding IsOwned}" Width="36" Height="36"
                                                            CornerRadius="10" HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding Code}" FontFamily="{StaticResource FontMono}" FontSize="12"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Classes="tile-name" Classes.owned="{Binding IsOwned}" Text="{Binding Name}"
                                                               FontSize="12" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"
                                                               HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Panel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsEditing}">
                                <Button Content="Give all" Classes="ww-ghost" Command="{Binding GiveAllItemsCommand}"
                                        ToolTip.Tip="Every item, the best sword and shield, bracelets and max capacities" />
                                <Button Content="Clear the item menu" Classes="ww-danger" MinHeight="40" Command="{Binding ClearInventoryCommand}" />
                            </StackPanel>

                            <Border CornerRadius="12" Background="{StaticResource InsetBrush}" Padding="12,10">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                        <Path Classes="icon" Data="{StaticResource IconInfo}" Stroke="{StaticResource Text2Brush}" />
                                    </Viewbox>
                                    <TextBlock Grid.Column="1" Margin="10,0,0,0" FontSize="13" Foreground="{StaticResource Text2Brush}" TextWrapping="Wrap"
                                               Text="Never shared: bomb and arrow counts, bottle contents, health and magic. Small keys are shared per dungeon (Shared world)." />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Classes="ww-card" Padding="24,22">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Quest status" Classes="ww-card-title" />
                            <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,14,Auto,14,Auto,14,Auto" IsEnabled="{Binding IsEditing}">
                                <TextBlock Grid.Row="0" Text="Songs" FontSize="13" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Top" Margin="0,9,0,0" />
                                <ItemsControl Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Songs}" Margin="0,0,0,-8">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FlagOption">
                                            <Button Classes="ww-option pill" Classes.active="{Binding IsOn}" Content="{Binding Label}" Margin="0,0,8,8"
                                                    Command="{Binding #Root.((vm:RoomItemsViewModel)DataContext).ToggleSongCommand}" CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Grid.Row="2" Text="Pearls" FontSize="13" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
                                <ItemsControl Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Pearls}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FlagOption">
                                            <Button Classes="ww-option pill" Classes.active="{Binding IsOn}" Padding="10,0,14,0"
                                                    Command="{Binding #Root.((vm:RoomItemsViewModel)DataContext).TogglePearlCommand}" CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{Binding Label}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Ellipse Width="12" Height="12" Fill="{Binding Dot}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Grid.Row="4" Text="Triforce shards" FontSize="13" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <ItemsControl ItemsSource="{Binding Shards}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:FlagOption">
                                                <Button Classes="ww-bare" Width="40" Height="40" ToolTip.Tip="{Binding Label}" AutomationProperties.Name="{Binding Label}"
                                                        Command="{Binding #Root.((vm:RoomItemsViewModel)DataContext).PickShardCommand}" CommandParameter="{Binding}">
                                                    <Viewbox Width="26" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Path Classes="shard" Classes.on="{Binding IsOn}" Width="24" Height="24"
                                                              Data="{StaticResource IconShard}" StrokeThickness="1.5" StrokeJoin="Round" />
                                                    </Viewbox>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding ShardText}" FontSize="13" Foreground="{StaticResource Text2Brush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>

                                <TextBlock Grid.Row="6" Text="Upgrades" FontSize="13" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
                                <ItemsControl Grid.Row="6" Grid.Column="1" ItemsSource="{Binding Upgrades}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FlagOption">
                                            <Button Classes="ww-option pill" Classes.active="{Binding IsOn}" Content="{Binding Label}" Margin="0,0,8,0"
                                                    Command="{Binding #Root.((vm:RoomItemsViewModel)DataContext).ToggleUpgradeCommand}" CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══ Right: equipment, hearts & magic, capacity ═══ -->
                <StackPanel Grid.Column="2" Spacing="20">
                    <Border Classes="ww-card" Padding="24,22">
                        <StackPanel Spacing="14" IsEnabled="{Binding IsEditing}">
                            <TextBlock Text="Equipment" Classes="ww-card-title" />
                            <TextBlock Text="SWORD" Classes="ww-label" />
                            <ItemsControl ItemsSource="{Binding SwordOptions}" Margin="-4">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ChoiceOption">
                                        <Button Classes="ww-option" Classes.active="{Binding IsSelected}" Margin="4" HorizontalAlignment="Stretch"
                                                Command="{Binding #Root.((vm:RoomItemsViewModel)DataContext).SetSwordCommand}" CommandParameter="{Binding Key}" AutomationProperties.Name="{Binding Label}" Padding="10,6">
                                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap" TextAlignment="Center" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="SHIELD" Classes="ww-label" Margin="0,4,0,0" />
                            <ItemsControl ItemsSource="{Binding ShieldOptions}" Margin="-4">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ChoiceOption">
                                        <Button Classes="ww-option" Classes.active="{Binding IsSelected}" Margin="4" HorizontalAlignment="Stretch"
                                                Command="{Binding #Root.((vm:RoomItemsViewModel)DataContext).SetShieldCommand}" CommandParameter="{Binding Key}" AutomationProperties.Name="{Binding Label}" Padding="10,6">
                                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap" TextAlignment="Center" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Classes="ww-card" Padding="24,22">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Hearts and magic" Classes="ww-card-title" />
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                <TextBlock Text="Max hearts" FontSize="13" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="ww-secondary" Width="44" Padding="0" HorizontalContentAlignment="Center"
                                        Content="−" FontSize="20" Command="{Binding HeartDownCommand}" IsEnabled="{Binding IsEditing}"
                                        ToolTip.Tip="One heart fewer" />
                                <TextBlock Grid.Column="2" Text="{Binding MaxHeartsText}" MinWidth="44" TextAlignment="Center"
                                           FontFamily="{StaticResource FontHeading}" FontWeight="SemiBold" FontSize="24" VerticalAlignment="Center" />
                                <Button Grid.Column="3" Classes="ww-secondary" Width="44" Padding="0" HorizontalContentAlignment="Center"
                                        Content="+" FontSize="20" Command="{Binding HeartUpCommand}" IsEnabled="{Binding IsEditing}"
                                        ToolTip.Tip="One heart more" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding HeartIcons}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Viewbox Width="18" Height="18" Margin="0,0,3,3">
                                            <Path Width="24" Height="24" Data="{StaticResource IconHeart}" Fill="{StaticResource HeartBrush}" />
                                        </Viewbox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding HeartsText}" FontSize="12" Foreground="{StaticResource Text3Brush}" Margin="0,-8,0,0" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Magic meter" FontSize="13" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Classes="ww-inset" CornerRadius="12" Padding="4">
                                    <ItemsControl ItemsSource="{Binding MagicOptions}" IsEnabled="{Binding IsEditing}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ChoiceOption">
                                                <Button Classes="ww-seg small" Classes.active="{Binding IsSelected}" Content="{Binding Label}"
                                                        Command="{Binding #Root.((vm:RoomItemsViewModel)DataContext).SetMagicCommand}" CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="ww-card" Padding="24,22">
                        <StackPanel Spacing="14" IsEnabled="{Binding IsEditing}">
                            <TextBlock Text="Capacity" Classes="ww-card-title" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Wallet" FontSize="13" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Classes="ww-inset" CornerRadius="12" Padding="4">
                                    <ItemsControl ItemsSource="{Binding WalletOptions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ChoiceOption">
                                                <Button Classes="ww-seg small mono" Classes.active="{Binding IsSelected}" Content="{Binding Label}" MinWidth="56"
                                                        Command="{Binding #Root.((vm:RoomItemsViewModel)DataContext).SetWalletCommand}" CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Quiver" FontSize="13" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Classes="ww-inset" CornerRadius="12" Padding="4">
                                    <ItemsControl ItemsSource="{Binding QuiverOptions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ChoiceOption">
                                                <Button Classes="ww-seg small mono" Classes.active="{Binding IsSelected}" Content="{Binding Label}" MinWidth="56"
                                                        Command="{Binding #Root.((vm:RoomItemsViewModel)DataContext).SetQuiverCommand}" CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Bomb bag" FontSize="13" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Classes="ww-inset" CornerRadius="12" Padding="4">
                                    <ItemsControl ItemsSource="{Binding BombBagOptions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ChoiceOption">
                                                <Button Classes="ww-seg small mono" Classes.active="{Binding IsSelected}" Content="{Binding Label}" MinWidth="56"
                                                        Command="{Binding #Root.((vm:RoomItemsViewModel)DataContext).SetBombBagCommand}" CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Grid>
                            <TextBlock Text="Capacities only: arrow and bomb counts stay with each player." FontSize="12"
                                       Foreground="{StaticResource Text3Brush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
